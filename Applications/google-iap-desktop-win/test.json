{
  "platform": "windows",
  "description": "Stages the MSI and registers Active Setup as SYSTEM; a second run must also succeed, and a non-https msiUrl must be refused. The per-user install at logon, and the app launching, need a real interactive logon, so those steps are Tier 2.",
  "variables": {},
  "steps": [
    {
      "type": "runComponent",
      "label": "Stage as SYSTEM",
      "expectExitCode": 0,
      "outputContains": ["IAP Desktop staged:"]
    },
    { "type": "file", "label": "MSI staged", "path": "%ProgramData%\\TechCollective\\IapDesktop\\IapDesktop.msi" },
    { "type": "file", "label": "Per-user stub written", "path": "%ProgramData%\\TechCollective\\IapDesktop\\Install-IapDesktop-User.cmd" },
    {
      "type": "registry",
      "label": "Active Setup StubPath",
      "path": "HKLM:\\SOFTWARE\\Microsoft\\Active Setup\\Installed Components\\{6f1c2b8e-4a4d-4b0e-9c2a-5d1e7f3a9b01}",
      "name": "StubPath",
      "matches": "Install-IapDesktop-User\\.cmd"
    },
    {
      "type": "registry",
      "label": "Active Setup IsInstalled",
      "path": "HKLM:\\SOFTWARE\\Microsoft\\Active Setup\\Installed Components\\{6f1c2b8e-4a4d-4b0e-9c2a-5d1e7f3a9b01}",
      "name": "IsInstalled",
      "equals": "1"
    },
    {
      "type": "registry",
      "label": "Active Setup Version is comma-separated",
      "path": "HKLM:\\SOFTWARE\\Microsoft\\Active Setup\\Installed Components\\{6f1c2b8e-4a4d-4b0e-9c2a-5d1e7f3a9b01}",
      "name": "Version",
      "matches": "^[0-9]+(,[0-9]+)+$"
    },
    {
      "type": "activeSetup",
      "label": "Simulated user logon",
      "tier": 2,
      "key": "{6f1c2b8e-4a4d-4b0e-9c2a-5d1e7f3a9b01}",
      "log": "%LOCALAPPDATA%\\IapDesktop-install.log"
    },
    {
      "type": "file",
      "label": "Installed for the user",
      "tier": 2,
      "as": "testuser",
      "path": "%LOCALAPPDATA%\\Google\\IAP Desktop\\IapDesktop.exe"
    },
    {
      "type": "launch",
      "label": "Launches as the user",
      "tier": 2,
      "as": "testuser",
      "path": "%LOCALAPPDATA%\\Google\\IAP Desktop\\IapDesktop.exe",
      "aliveSeconds": 15
    },
    {
      "type": "runComponent",
      "label": "Second run succeeds",
      "expectExitCode": 0
    },
    {
      "type": "runComponent",
      "label": "Refuses a non-https msiUrl",
      "variables": { "msiUrl": "http://example.com/IapDesktop.msi" },
      "expectExitCode": 3
    }
  ]
}
